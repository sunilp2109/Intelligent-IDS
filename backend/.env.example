# Copy this file to .env and adjust values for your environment.
# SQLite is used for Module 1. Switch to PostgreSQL later by changing DATABASE_URL, for example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/intelligent_ids

DATABASE_URL=sqlite:///./ids.db

# Comma-separated list of frontend origins allowed during development.
# Browser WebSocket connections must also use one of these origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5174

# Application-level WebSocket keep-alive in seconds. 0 disables heartbeats (tests).
WS_HEARTBEAT_SECONDS=30
WS_SEND_TIMEOUT_SECONDS=2
